---
// Dark/light toggle. The initial theme is set in BaseLayout's inline head
// script; this button flips it and persists the choice.
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <!-- Sun (shown in dark mode → click for light) -->
  <svg class="icon sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
    fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Moon (shown in light mode → click for dark) -->
  <svg class="icon moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
    fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--accent);
    background: var(--code-bg);
  }
  .icon { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .sun { display: block; }
  :global(:root[data-theme='light']) .theme-toggle .moon { display: block; }
  /* Fallback before JS sets data-theme: show moon. */
  :global(:root:not([data-theme='dark'])) .theme-toggle .moon { display: block; }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
