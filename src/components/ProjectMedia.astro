---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const initials = project.data.title
  .split(' ')
  .slice(0, 2)
  .map((word) => word[0])
  .join('');
---

<div class="project-media">
  {
    project.data.image ? (
      <Image
        src={project.data.image}
        alt={project.data.imageAlt!}
        loading="lazy"
        widths={[480, 960, 1440]}
        sizes="(min-width: 768px) 50vw, 100vw"
      />
    ) : (
      <div class="placeholder" role="img" aria-label={`Image for ${project.data.title} coming soon`}>
        <span class="initials" aria-hidden="true">{initials}</span>
        <span class="placeholder-label">Image coming soon</span>
      </div>
    )
  }
</div>

<style>
  .project-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--code-bg);
  }

  .project-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1rem, 3vw, 1.5rem);
    color: var(--muted);
  }

  .initials {
    align-self: center;
    margin-block: auto;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.08em;
    color: var(--accent-quiet);
  }

  .placeholder-label {
    font-size: var(--fs-meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
