---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectItem from '../components/ProjectItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
import { experience } from '../data/experience';
import { skills } from '../data/skills';

const featuredExperience = experience.filter((item) => item.featured);
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="subtitle">{site.subtitle}</p>
    <div class="hero-socials"><SocialLinks /></div>
  </section>

  <!-- Experience + Skills -->
  <section class="block">
    <div class="exp-grid">
      <div class="exp-main">
        <h2 class="section-title">Experience</h2>
        <div class="timeline">
          {featuredExperience.map((item) => <ExperienceItem item={item} />)}
        </div>
      </div>
      <aside class="exp-skills">
        <h2 class="section-title">Skills</h2>
        {
          skills.map((group) => (
            <div class="skill-group">
              <p class="meta">{group.label}</p>
              <div class="pills">
                {group.items.map((skill) => <span class="pill">{skill}</span>)}
              </div>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <!-- Projects -->
  <section class="block">
    <h2 class="section-title">Projects</h2>
    <div class="projects">
      {projects.map((project) => <ProjectItem project={project} />)}
    </div>
  </section>

  <!-- Education -->
  <section class="block">
    <h2 class="section-title">Education</h2>
    <div class="education">
      <h3 class="edu-school">{site.education.school}</h3>
      <p class="edu-detail meta">{site.education.detail}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero stays a narrow reading column within the wide container. */
  .hero {
    max-width: var(--measure);
    padding-top: clamp(2.5rem, 8vw, 4.5rem);
    padding-bottom: var(--section-gap);
  }
  .name {
    font-size: var(--fs-display);
    font-weight: 420;
  }
  .tagline {
    margin-top: 1.1rem;
    font-size: 1.2rem;
    font-weight: 500;
  }
  .subtitle {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: 48ch;
  }
  .hero-socials { margin-top: 1.6rem; }

  .block {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--hairline);
  }

  /* Experience (left) + Skills (right). Single column below 768px:
     experience then skills. */
  .exp-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .timeline { display: grid; gap: 1.75rem; }
  .skill-group + .skill-group { margin-top: 1.1rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }

  .projects { display: grid; grid-template-columns: 1fr; }

  .edu-school { font-size: var(--fs-h3); }
  .edu-detail { margin-top: 0.4rem; }

  @media (min-width: 768px) {
    .exp-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      gap: 3rem;
    }
    .projects { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
    /* Keep the top row clean — drop the top hairline on the first two cards. */
    .projects :global(.project:nth-child(-n + 2)) { border-top: none; }
  }
</style>
